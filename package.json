{
  "name": "durable-news-agent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A durable pi news agent that keeps finding new news and ranks it as Hype, Facts and Signal with jev. The npm workspace root: every app in apps/ plus the shared packages.",
  "workspaces": [
    "apps/shared/packages/*",
    "apps/dna-*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "eval:tasks": "node scripts/eval-tasks/run.mjs",
    "eval:auto": "node scripts/eval-tasks/run.mjs --components",
    "eval:calibrate": "node scripts/eval-tasks/calibrate.mjs",
    "eval:prepare": "node scripts/eval-tasks/prepare.mjs",
    "eval:prepare-adjacent":"node scripts/eval-tasks/prepare-adjacent.mjs",
    "eval:candidates":"bash scripts/eval-tasks/candidate-campaign.sh",
    "eval:capture": "node scripts/eval-tasks/flywheel.mjs",
    "eval:regrade": "node scripts/eval-tasks/regrade.mjs",
    "eval:jev-check": "node --import tsx scripts/eval-tasks/check-jev.mjs",
    "eval:prepare-v4":"node scripts/eval-tasks/prepare-v4.mjs",
    "eval:selection-replay":"node --import tsx scripts/eval-tasks/selection-replay.mjs",
    "check": "npm run check --workspaces --if-present",
    "test": "npm test --workspaces --if-present",
    "lint": "oxlint apps/dna-* apps/shared",
    "fmt": "oxfmt -c shared-app-configuration/.oxfmtrc.json apps/dna-* apps/shared",
    "fmt:check": "oxfmt --check -c shared-app-configuration/.oxfmtrc.json apps/dna-* apps/shared"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "^24.0.0",
    "oxfmt": "0.72.0",
    "oxlint": "1.87.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
